# Application environment: development, test, or production
MEDIMIND_APP_ENV=production
# Logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL
MEDIMIND_LOG_LEVEL=INFO
# Log format: json or text
MEDIMIND_LOG_FORMAT=json
# Database connection URL
MEDIMIND_DATABASE_URL=sqlite:////app/data/db/medimind.db
# Allowed browser origins as a JSON array
MEDIMIND_CORS_ORIGINS=["http://localhost:8080"]
# Maximum symptoms accepted per request
MEDIMIND_MAX_SYMPTOMS=17
# Number of ranked predictions returned
MEDIMIND_TOP_K=5
