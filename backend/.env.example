# Copy to .env; all variables are optional.
MEDIMIND_APP_ENV=development
MEDIMIND_LOG_LEVEL=INFO
MEDIMIND_LOG_FORMAT=text
MEDIMIND_DATABASE_URL=sqlite:///./data/medimind.db
MEDIMIND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:3000"]
MEDIMIND_MAX_SYMPTOMS=17
MEDIMIND_TOP_K=5
