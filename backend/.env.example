# Copy to .env; all variables are optional.
MEDIMIND_APP_ENV=development
MEDIMIND_LOG_LEVEL=INFO
MEDIMIND_LOG_FORMAT=text
MEDIMIND_DATABASE_URL=sqlite:///./data/medimind.db
MEDIMIND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MEDIMIND_MAX_SYMPTOMS=17
MEDIMIND_TOP_K=5
MEDIMIND_MIN_PROB=0.01
MEDIMIND_HISTORY_LIMIT=50
# Optional overrides for data and model locations
# MEDIMIND_DATA_DIR=./data
# MEDIMIND_MODEL_DIR=./models
